@model List<Planbord.Web.Pages.Dagrapporten.RapportRij>
@{
    var datum = ViewContext.HttpContext.Request.Query["datum"].ToString();
    var ontbrekend = Model.Count(r => r.Rapport is null or { Status: RapportStatus.Concept });
}
@if (Model.Count == 0)
{
    <p class="text-muted">Niemand gepland op deze dag.</p>
    return;
}
<p>@(Model.Count - ontbrekend) van @Model.Count ingediend.@if (ontbrekend > 0) { <strong class="text-danger"> @ontbrekend ontbreken nog.</strong> }</p>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th scope="col">Medewerker</th><th scope="col">Status</th><th scope="col">Per werf</th><th scope="col">Totaal</th><th scope="col"><span class="visually-hidden">Acties</span></th></tr>
        </thead>
        <tbody>
            @foreach (var rij in Model)
            {
                var r = rij.Rapport;
                var label = r?.Status switch { null => "Niet ingevuld", RapportStatus.Concept => "Concept", RapportStatus.Ingediend => "Ingediend", _ => "Gesloten" };
                var kleur = r?.Status switch { RapportStatus.Ingediend => "text-bg-primary", RapportStatus.Gesloten => "text-bg-success", _ => "text-bg-warning" };
                <tr>
                    <td>@rij.Medewerker.Naam</td>
                    <td><span class="badge @kleur">@label</span></td>
                    <td class="small">
                        @if (r is null || r.Regels.Count == 0)
                        {
                            @string.Join(", ", rij.Werven)
                        }
                        else
                        {
                            foreach (var regel in r.Regels)
                            {
                                <div><strong>@rij.ProjectNamen.GetValueOrDefault(regel.ProjectId)</strong> · @regel.Status · @Duur.Formatteer(regel.Minuten)@if (!string.IsNullOrEmpty(regel.Omschrijving)) { <span class="text-muted"> — @regel.Omschrijving</span> }</div>
                            }
                        }
                    </td>
                    <td>@(r is null ? "—" : Duur.Formatteer(r.Regels.Where(x => x.Status == RegelStatus.GEWERKT).Sum(x => x.Minuten)))</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/MijnDag" asp-route-medewerkerId="@rij.Medewerker.Id" asp-route-datum="@datum">Station</a>
                        @if (r is { Status: RapportStatus.Ingediend })
                        {
                            <form method="post" asp-page="/Dagrapporten/Index" asp-page-handler="Sluit" asp-route-id="@r.Id" asp-route-datum="@datum" class="d-inline"><button class="btn btn-sm btn-success">Sluiten</button></form>
                        }
                        @if (r is { Status: not RapportStatus.Concept })
                        {
                            <form method="post" asp-page="/Dagrapporten/Index" asp-page-handler="Vrijgeven" asp-route-id="@r.Id" asp-route-datum="@datum" class="d-inline"><button class="btn btn-sm btn-outline-warning">Vrijgeven</button></form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
