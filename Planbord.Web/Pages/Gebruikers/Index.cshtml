@page
@model Planbord.Web.Pages.Gebruikers.IndexModel
@{
    ViewData["Title"] = "Gebruikers";
}
<h1 class="h3">Gebruikers</h1>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">E-mail</th><th scope="col">Rol en koppeling</th><th scope="col"><span class="visually-hidden">Acties</span></th></tr></thead>
                <tbody>
                    @foreach (var (u, rol) in Model.Lijst)
                    {
                        <tr>
                            <td>@u.Email@if (!u.EmailConfirmed) { <div class="small text-muted">Uitnodiging openstaand</div> }</td>
                            <td>
                                <form method="post" asp-page-handler="Wijzig" asp-route-id="@u.Id" class="d-flex flex-wrap gap-1">
                                    <label class="visually-hidden" for="r-@u.Id">Rol</label>
                                    <select class="form-select form-select-sm w-auto" id="r-@u.Id" name="rol">
                                        @foreach (var r in Rollen.Alle) { <option value="@r" selected="@(r == rol)">@r</option> }
                                    </select>
                                    <label class="visually-hidden" for="m-@u.Id">Medewerker</label>
                                    <select class="form-select form-select-sm w-auto" id="m-@u.Id" name="medewerkerId">
                                        <option value="">Geen medewerker</option>
                                        @foreach (var m in Model.Medewerkers) { <option value="@m.Id" selected="@(m.Id == u.MedewerkerId)">@m.Naam</option> }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary">Opslaan</button>
                                </form>
                            </td>
                            <td class="text-end">
                                @if (!u.EmailConfirmed)
                                {
                                    <form method="post" asp-page-handler="Link" asp-route-id="@u.Id"><button class="btn btn-sm btn-outline-secondary">Nieuwe link</button></form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <h2 class="h5">Uitnodigen</h2>
        <form method="post" asp-page-handler="Uitnodigen" class="mb-5">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="mb-2">
                <label asp-for="Form.Email" class="form-label"></label>
                <input asp-for="Form.Email" class="form-control" />
                <span asp-validation-for="Form.Email" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Form.Rol" class="form-label"></label>
                <select asp-for="Form.Rol" class="form-select" asp-items="@(new SelectList(Rollen.Alle))"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Form.MedewerkerId" class="form-label"></label>
                <select asp-for="Form.MedewerkerId" class="form-select" asp-items="@(new SelectList(Model.Medewerkers, "Id", "Naam"))">
                    <option value="">Geen</option>
                </select>
            </div>
            <button class="btn btn-primary">Uitnodiging aanmaken</button>
            <p class="small text-muted mt-2">E-mail is niet ingesteld: je krijgt een activatielink om zelf te bezorgen.</p>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
