@page
@model Planbord.Web.Pages.Projecten.IndexModel
@{
    ViewData["Title"] = "Projecten";
}
<div class="d-flex align-items-center mb-3">
    <h1 class="h3 mb-0">Projecten</h1>
    <a class="ms-auto small" asp-route-toonArchief="@(!Model.ToonArchief)">@(Model.ToonArchief ? "Verberg archief" : "Toon archief")</a>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Naam</th><th scope="col">Adres</th><th scope="col">Periode</th><th scope="col">Open taken</th><th scope="col"><span class="visually-hidden">Acties</span></th></tr></thead>
                <tbody>
                    @foreach (var (p, open) in Model.Projecten)
                    {
                        <tr class="@(p.Gearchiveerd ? "text-muted" : "")">
                            <td><a asp-page="Detail" asp-route-id="@p.Id">@p.Naam</a>@if (p.Gearchiveerd) { <span class="small"> (gearchiveerd)</span> }</td>
                            <td>@p.Adres</td>
                            <td class="small text-nowrap">@(p.Startdatum?.ToString("dd/MM/yy") ?? "?") – @(p.Einddatum?.ToString("dd/MM/yy") ?? "geen einde")</td>
                            <td>@open</td>
                            <td class="text-end">
                                @if (p.Gearchiveerd)
                                {
                                    <form method="post" asp-page-handler="Herstel" asp-route-id="@p.Id"><button class="btn btn-sm btn-outline-secondary">Herstellen</button></form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Verwijder" asp-route-id="@p.Id" onsubmit="return confirm('Project verwijderen of archiveren?')"><button class="btn btn-sm btn-outline-danger">Verwijderen</button></form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <h2 class="h5">Nieuw project</h2>
        <form method="post">
            <div class="mb-2">
                <label asp-for="Form.Naam" class="form-label"></label>
                <input asp-for="Form.Naam" class="form-control" />
                <span asp-validation-for="Form.Naam" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Form.Adres" class="form-label"></label>
                <input asp-for="Form.Adres" class="form-control" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col"><label asp-for="Form.Startdatum" class="form-label"></label><input asp-for="Form.Startdatum" class="form-control" /></div>
                <div class="col"><label asp-for="Form.Einddatum" class="form-label"></label><input asp-for="Form.Einddatum" class="form-control" /></div>
                <span asp-validation-for="Form.Einddatum" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary">Aanmaken</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
