@page
@model Planbord.Web.Pages.Medewerkers.AfwezighedenModel
@{
    ViewData["Title"] = "Afwezigheden";
}
<h1 class="h3">Afwezigheden</h1>
<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Lijst.Count == 0) { <p class="text-muted">Geen recente of geplande afwezigheden.</p> }
        <ul class="list-group">
            @foreach (var a in Model.Lijst)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    <div>
                        <strong>@a.Medewerker.Naam</strong> · @a.Reden
                        <div class="small text-muted">@a.Van.ToString("ddd d MMM") – @a.Tot.ToString("ddd d MMM yyyy")</div>
                    </div>
                    <form method="post" asp-page-handler="Verwijder" asp-route-id="@a.Id" class="ms-auto">
                        <button class="btn btn-sm btn-link text-danger">Verwijderen</button>
                    </form>
                </li>
            }
        </ul>
    </div>
    <div class="col-lg-5">
        <h2 class="h5">Afwezigheid registreren</h2>
        <form method="post">
            <div class="mb-2">
                <label asp-for="Form.MedewerkerId" class="form-label"></label>
                <select asp-for="Form.MedewerkerId" class="form-select" asp-items="@(new SelectList(Model.Medewerkers, "Id", "Naam"))">
                    <option value="">Kies…</option>
                </select>
                <span asp-validation-for="Form.MedewerkerId" class="text-danger small"></span>
            </div>
            <div class="row g-2 mb-2">
                <div class="col">
                    <label asp-for="Form.Van" class="form-label"></label>
                    <input asp-for="Form.Van" class="form-control" />
                </div>
                <div class="col">
                    <label asp-for="Form.Tot" class="form-label"></label>
                    <input asp-for="Form.Tot" class="form-control" />
                    <span asp-validation-for="Form.Tot" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Reden" class="form-label"></label>
                <input asp-for="Form.Reden" class="form-control" list="redenen" />
                <datalist id="redenen"><option value="Verlof"></option><option value="Ziek"></option><option value="Opleiding"></option></datalist>
                <span asp-validation-for="Form.Reden" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary">Registreren</button>
            <p class="small text-muted mt-2">Bestaande planning in deze periode wordt gewist.</p>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
